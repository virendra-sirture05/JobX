pipeline {
    agent any

    tools {
        maven 'Maven-3.9.16'
    }

    environment {
        DOCKERHUB_USERNAME = 'ritesh8554'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Environment') {
            steps {
                sh '''
                    set -eux

                    echo "=== Jenkins Environment ==="
                    whoami
                    pwd
                    java -version
                    mvn -version
                    docker --version
                    git --version
                '''
            }
        }

        stage('Checkout Verification') {
            steps {
                sh '''
                    set -eux

                    echo "=== Git Branch ==="
                    git branch --show-current || true

                    echo "=== Latest Commit ==="
                    git log -1 --oneline

                    echo "=== Backend Structure ==="
                    ls -la
                    ls -la "Job Portal/job-portal-system"
                '''
            }
        }

        stage('Verify Maven Project') {
            steps {
                dir('Job Portal/job-portal-system') {
                    sh '''
                        set -eux
                        mvn -B -ntp validate
                    '''
                }
            }
        }
        stage('Build Service Registry Image') {
            steps {
                dir('Job Portal/job-portal-system') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'jobx-dockerhub',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -eux

                            mvn -B -ntp \
                              -pl cloud/job-portal-service-registry \
                              -am \
                              clean package jib:build \
                              -Djib.to.image=ritesh8554/job-portal-service-registry \
                              -Djib.to.tags=${IMAGE_TAG} \
                              -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                              -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                        '''
                    }
                }
            }
        }
        stage('Build Config Server Image') {
            steps {
                dir('Job Portal/job-portal-system') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'jobx-dockerhub',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        )
                    ]) {
                                       sh '''
                                           set -eux

                                           echo "=== Building Config Server ==="
                                           echo "Image: ritesh8554/job-portal-config-server:${IMAGE_TAG}"

                                           mvn -B -ntp \
                                             -pl cloud/job-portal-config-server \
                                             -am \
                                             clean package \
                                             jib:build \
                                             -Djib.to.image=ritesh8554/job-portal-config-server \
                                             -Djib.to.tags=${IMAGE_TAG} \
                                             -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                             -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                       '''
                    }
                }
            }
        }
         stage('Build API Gateway Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    mvn -B -ntp \
                                      -pl cloud/job-portal-api-gateway \
                                      -am \
                                      clean package jib:build \
                                      -DskipTests \
                                      -Djib.to.image=ritesh8554/job-portal-api-gateway \
                                      -Djib.to.tags=${IMAGE_TAG} \
                                      -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                      -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }
                stage('Build Application Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux
                                    mvn -B -ntp -pl services/job-portal-application-service -am \
                                      clean install -DskipTests
                                    mvn -B -ntp \
                                        -pl services/job-portal-application-service \
                                        jib:build \
                                        -Djib.to.image=ritesh8554/job-portal-application-service \
                                        -Djib.to.tags=${IMAGE_TAG} \
                                        -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                        -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }

                stage('Build Company Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([usernamePassword(credentialsId: 'jobx-dockerhub', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')])
                            {
                                                            sh '''
                                                                set -eux
                                                                mvn -B -ntp -pl services/job-portal-company-service -am \
                                                                  clean install -DskipTests
                                                                mvn -B -ntp \
                                                                    -pl services/job-portal-company-service \
                                                                    jib:build \
                                                                    -Djib.to.image=ritesh8554/job-portal-company-service \
                                                                    -Djib.to.tags=${IMAGE_TAG} \
                                                                    -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                                                    -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                                            '''
                                                        }
                        }
                    }
                }

                stage('Build Job Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([usernamePassword(credentialsId: 'jobx-dockerhub', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')])
                            {
                                                            sh '''
                                                                set -eux
                                                                mvn -B -ntp -pl services/job-portal-job-service -am \
                                                                  clean install -DskipTests
                                                                mvn -B -ntp \
                                                                    -pl services/job-portal-job-service \
                                                                    jib:build \
                                                                    -Djib.to.image=ritesh8554/job-portal-job-service \
                                                                    -Djib.to.tags=${IMAGE_TAG} \
                                                                    -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                                                    -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                                            '''
                                                        }
                        }
                    }
                }
                stage('Build Notification Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    echo "=== Building Notification Service ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-notification-service \
                                      -am \
                                      clean install \
                                      -DskipTests

                                    echo "=== Building Notification Service Image ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-notification-service \
                                      jib:build \
                                      -Djib.to.image=ritesh8554/job-portal-notification-service \
                                      -Djib.to.tags=${IMAGE_TAG} \
                                      -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                      -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }
                stage('Build Preferences Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    echo "=== Building Preferences Service ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-preferences \
                                      -am \
                                      clean install \
                                      -DskipTests

                                    echo "=== Building Preferences Service Image ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-preferences \
                                      jib:build \
                                      -Djib.to.image=ritesh8554/job-portal-preference-service \
                                      -Djib.to.tags=${IMAGE_TAG} \
                                      -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                      -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }
                stage('Build Resume Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    echo "=== Building Resume Service ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-resume-service \
                                      -am \
                                      clean install \
                                      -DskipTests

                                    echo "=== Building Resume Service Image ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-resume-service \
                                      jib:build \
                                      -Djib.to.image=ritesh8554/job-portal-resume-service \
                                      -Djib.to.tags=${IMAGE_TAG} \
                                      -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                      -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }
                stage('Build User Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    echo "=== Building User Service ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-user-service \
                                      -am \
                                      clean install \
                                      -DskipTests

                                    echo "=== Building User Service Image ==="

                                    mvn -B -ntp \
                                      -pl services/job-portal-user-service \
                                      jib:build \
                                      -Djib.to.image=ritesh8554/job-portal-user-service \
                                      -Djib.to.tags=${IMAGE_TAG} \
                                      -Djib.to.auth.username="${DOCKERHUB_USERNAME}" \
                                      -Djib.to.auth.password="${DOCKERHUB_PASSWORD}"
                                '''
                            }
                        }
                    }
                }
                stage('Build AI Service Image') {
                    steps {
                        dir('Job Portal/job-portal-system/services/job-portal-ai-service') {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'jobx-dockerhub',
                                    usernameVariable: 'DOCKERHUB_USERNAME',
                                    passwordVariable: 'DOCKERHUB_PASSWORD'
                                )
                            ]) {
                                sh '''
                                    set -eux

                                    IMAGE_NAME=ritesh8554/job-portal-ai-service:${IMAGE_TAG}

                                    echo "=== Building AI Service Docker Image ==="
                                    echo "Image: ${IMAGE_NAME}"

                                    echo "${DOCKERHUB_PASSWORD}" | docker login \
                                      -u "${DOCKERHUB_USERNAME}" \
                                      --password-stdin

                                    docker build \
                                      --pull \
                                      -t "${IMAGE_NAME}" \
                                      .

                                    echo "=== Pushing AI Service Image ==="

                                    docker push "${IMAGE_NAME}"

                                    docker logout
                                '''
                            }
                        }
                    }
                }
        stage('Deploy to EC2') {
            steps {
                sshagent(credentials: ['jobx-ec2-ssh']) {
                    sh '''
                set -eux

                echo "========================================="
                echo "Deploying JobX release: ${IMAGE_TAG}"
                echo "========================================="

                ssh -o StrictHostKeyChecking=no \
                    ec2-user@13.205.248.245 \
                    "
                    set -e

                    cd /home/ec2-user/jobx

                    echo 'Deploying IMAGE_TAG=${IMAGE_TAG}'

                    IMAGE_TAG=${IMAGE_TAG} docker compose pull

                    IMAGE_TAG=${IMAGE_TAG} docker compose up -d --remove-orphans

                    echo '=== Running Containers ==='
                    docker compose ps
                    "
            '''
                }
            }
        }
        stage('Summary') {
            steps {
                script {
                    echo "Build Number: ${env.BUILD_NUMBER}"
                    echo "Commit: ${env.GIT_COMMIT}"
                    echo "Branch: ${env.BRANCH_NAME ?: 'docker'}"
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
            deleteDir()
        }

        success {
            echo 'JobX backend CI validation succeeded.'
        }

        failure {
            echo 'JobX backend CI validation failed. Check the stage logs.'
        }
    }
}